# ==============================================================================
# Sellbar.in - Production & Development Environment Configuration
# ==============================================================================
# Copy this file to .env.local for local development or set in your Hostinger/VPS panel.

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ------------------------------------------------------------------------------
# 1. Database: MongoDB Atlas & Mongoose ODM
# ------------------------------------------------------------------------------
# MongoDB connection string from MongoDB Atlas Cluster -> Connect -> Drivers
MONGODB_URI="mongodb+srv://sellbar_admin:<password>@cluster0.sellbar.mongodb.net/sellbar_db?retryWrites=true&w=majority"

# Optional PostgreSQL URL if using Prisma:
# DATABASE_URL="postgresql://user:password@localhost:5432/sellbar_db?schema=public"

# ------------------------------------------------------------------------------
# 2. Payments: Razorpay (UPI, RuPay, Credit/Debit Cards, NetBanking, EMI)
# ------------------------------------------------------------------------------
# In development, leave default to use Sellbar Sandbox Mode
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="your_razorpay_secret_here"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret_here"

# ------------------------------------------------------------------------------
# 3. Indian Phone OTP & SMS: MSG91
# ------------------------------------------------------------------------------
# Get your Auth Key from control.msg91.com
MSG91_AUTH_KEY="your_msg91_auth_key"
MSG91_OTP_TEMPLATE_ID="sellbar_otp_login"
MSG91_SENDER_ID="SELBAR"

# ------------------------------------------------------------------------------
# 4. Logistics & Reverse Pickup: Shiprocket
# ------------------------------------------------------------------------------
# Shiprocket credentials for automatic waybill creation and doorstep technician pickup
SHIPROCKET_EMAIL="logistics@sellbar.in"
SHIPROCKET_PASSWORD="your_shiprocket_password"

# ------------------------------------------------------------------------------
# 5. Transactional Emails & Invoices: Resend
# ------------------------------------------------------------------------------
# API Key from resend.com/api-keys
RESEND_API_KEY="re_123456789_abcdef"
RESEND_FROM_EMAIL="Sellbar Orders <orders@sellbar.in>"

# ------------------------------------------------------------------------------
# 6. Product & Inspection Images: Cloudinary
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME="sellbar"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="sellbar"

# ------------------------------------------------------------------------------
# 7. Error Monitoring: Sentry
# ------------------------------------------------------------------------------
SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
NEXT_PUBLIC_SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"

# ------------------------------------------------------------------------------
# 8. User Journeys & Product Analytics: PostHog
# ------------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY="phc_your_posthog_key"
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# ------------------------------------------------------------------------------
# 9. Authentication & Security
# ------------------------------------------------------------------------------
AUTH_SECRET="sellbar_super_secret_session_encryption_key_at_least_32_chars"
